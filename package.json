{
  "name": "decree-harness",
  "version": "0.1.1",
  "description": "Give coding agents your team's decisions (ADRs, CLAUDE.md/AGENTS.md rules, post-mortems), scoped to the files they touch, over MCP. Also generates full agent harnesses for a codebase.",
  "keywords": [
    "agent",
    "harness",
    "claude",
    "claude-code",
    "mcp",
    "mcp-server",
    "adr",
    "architecture-decision-records",
    "agents-md",
    "cursor-rules",
    "coding-agents",
    "context",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/TCYTseven/decree-app#readme",
  "bugs": {
    "url": "https://github.com/TCYTseven/decree-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TCYTseven/decree-app.git"
  },
  "license": "MIT",
  "author": "TCYTseven (https://github.com/TCYTseven)",
  "type": "module",
  "bin": {
    "decree-harness": "dist/cli.js",
    "decree": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.10",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
