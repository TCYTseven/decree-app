{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "kebab-case slug"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "goal": {
      "default": "",
      "type": "string"
    },
    "model": {
      "default": {
        "id": "claude-opus-5",
        "effort": "high",
        "subagentId": "claude-sonnet-5",
        "thinking": "adaptive"
      },
      "type": "object",
      "properties": {
        "id": {
          "default": "claude-opus-5",
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "default": "high",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "subagentId": {
          "default": "claude-sonnet-5",
          "type": "string",
          "minLength": 1
        },
        "thinking": {
          "default": "adaptive",
          "type": "string",
          "enum": [
            "adaptive",
            "off"
          ]
        }
      }
    },
    "systemPrompt": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "http",
              "shell",
              "read_file",
              "write_file",
              "list_files",
              "search",
              "web_search",
              "web_fetch",
              "memory"
            ]
          },
          "inputSchema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "JSON Schema (type: object) for the tool input"
          },
          "http": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "OPTIONS"
                ]
              },
              "baseUrlEnv": {
                "description": "Env var holding the base URL; defaults to <NAME>_BASE_URL",
                "type": "string",
                "minLength": 1
              },
              "defaultBaseUrl": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Path template, e.g. /users/{id}"
              },
              "queryParams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "headerParams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bodyParam": {
                "type": "string"
              },
              "auth": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "bearer",
                      "header",
                      "none"
                    ]
                  },
                  "env": {
                    "type": "string"
                  },
                  "header": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "method",
              "path"
            ]
          },
          "shell": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Command template; {{param}} placeholders are shell-escaped"
              },
              "cwd": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "command"
            ]
          },
          "fs": {
            "type": "object",
            "properties": {
              "root": {
                "default": ".",
                "type": "string",
                "minLength": 1
              },
              "maxBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "readOnly": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean"
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ]
      }
    },
    "subagents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "systemPrompt": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        },
        "required": [
          "name",
          "systemPrompt"
        ]
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "maxTurns": {
          "default": 40,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokensPerTurn": {
          "default": 32000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blockedCommands": {
          "default": [
            "rm -rf /",
            "rm -rf ~",
            "rm -rf *",
            "rm -rf .",
            "git push --force",
            "git push -f",
            "git reset --hard",
            "git clean -fd",
            "DROP DATABASE",
            "DROP TABLE",
            "TRUNCATE TABLE",
            "mkfs",
            "dd if=",
            ":(){ :|:& };:",
            "chmod -R 777",
            "shutdown",
            "reboot",
            "npm publish"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedPaths": {
          "default": [
            "."
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "redactEnv": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalMode": {
          "default": "destructive",
          "type": "string",
          "enum": [
            "always",
            "destructive",
            "never"
          ]
        }
      }
    },
    "context": {
      "default": {
        "caching": true,
        "compaction": true,
        "contextEditing": false,
        "memory": false
      },
      "type": "object",
      "properties": {
        "caching": {
          "default": true,
          "type": "boolean"
        },
        "compaction": {
          "default": true,
          "type": "boolean"
        },
        "contextEditing": {
          "default": false,
          "type": "boolean"
        },
        "memory": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "evals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "default": {},
            "type": "object",
            "properties": {
              "toolsCalled": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toolsNotCalled": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notContains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rubric": {
                "type": "string"
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "input"
        ]
      }
    },
    "targets": {
      "default": [
        "typescript",
        "claude-code"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "typescript",
          "python",
          "claude-code",
          "mcp"
        ]
      }
    },
    "env": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "secret": {
            "default": false,
            "type": "boolean"
          },
          "default": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": {
          "default": "heuristic",
          "type": "string",
          "enum": [
            "heuristic",
            "llm"
          ]
        },
        "decreeVersion": {
          "default": "0.1.0",
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "profileName": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "systemPrompt"
  ],
  "description": "decree-harness spec (decree.json)",
  "$id": "https://decree.dev/schema/decree.json",
  "title": "decree.json"
}
